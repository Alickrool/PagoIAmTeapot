# Copy to backend/.env

# Which LLM: "gemini" or "anthropic". If empty: whichever key below is set.
AI_PROVIDER=gemini

# Gemini (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Claude (Anthropic Console key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 1 = canned AI answers (no API calls). Also forced on when the chosen provider has no key.
AI_MOCK=0
DJANGO_DEBUG=1

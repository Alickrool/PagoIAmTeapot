# Copy to backend/.env (git-ignored). NEVER put real keys in this file: it is committed to git.

# Gemini key from Google AI Studio
GEMINI_API_KEY=
# Check which models your key can use: python manage.py ai_check
GEMINI_MODEL=gemini-3.5-flash-lite
# Used in order when the main model is overloaded (503) or rate-limited (429). Keep them light (3.5 and below).
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# 1 = canned AI answers (no API calls). Also forced on when GEMINI_API_KEY is empty.
AI_MOCK=0
DJANGO_DEBUG=1

# Rate limits per device (empty = off). Raise them for rehearsals if you hit 429.
SCAN_RATE=30/hour
ASK_RATE=120/hour

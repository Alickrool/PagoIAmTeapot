# Copy to backend/.env (git-ignored). NEVER put real keys in this file: it is committed to git.

# Gemini key from Google AI Studio
GEMINI_API_KEY=
# Check which models your key can use: python manage.py ai_check
GEMINI_MODEL=gemini-4-hydrogen

# 1 = canned AI answers (no API calls). Also forced on when GEMINI_API_KEY is empty.
AI_MOCK=0
DJANGO_DEBUG=1

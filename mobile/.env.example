# Copy to mobile/.env and restart `npx expo start`.
# Real phone with Expo Go: use your laptop's LAN IP (ipconfig -> IPv4), same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# 1 = no backend needed, data comes from shared/fixtures
EXPO_PUBLIC_MOCK=0
# Required for bill uploads on a phone: Expo SDK 58's built-in fetch rejects React Native file parts
# ({uri, name, type}) with "Unsupported FormDataPart implementation"; this restores React Native's fetch.
EXPO_PUBLIC_USE_RN_FETCH=1
